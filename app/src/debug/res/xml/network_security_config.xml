<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo en debug (spec 003, plan §6): permite HTTP sin cifrar únicamente hacia la Firebase Local Emulator Suite.
    10.0.2.2 es el equipo visto desde el emulador de Android; 127.0.0.1 y localhost sirven con `adb reverse`.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
