rules_version = '2';

// Reglas de seguridad de SmartFood (spec 001, RNF-02; spec 003, RNF-REC-02; spec 004, RNF-MAIL-04;
// spec 005, CA-LEG-02-02; spec 006, RNF-INV-01).
// Cada usuario solo puede leer y escribir su propio perfil y su inventario. Todo lo demás está denegado.
// Pruebas: rules-test/ (firebase emulators:exec --only firestore,storage "npm --prefix rules-test test").
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Preferencias alimentarias (spec 008, CA-PER-03-04): solo las claves del plan y valores permitidos. Las listas
      // pueden venir vacías y `spice`/`budget` se omiten cuando no hay elección (Firestore no acepta null).
      function validPreferences(p) {
        return p is map
          && p.keys().hasOnly(['restrictions', 'cuisines', 'spice', 'budget'])
          && (!('restrictions' in p) || (p.restrictions is list
              && p.restrictions.hasOnly(['VEGETARIAN', 'VEGAN', 'GLUTEN_FREE', 'LACTOSE_FREE', 'NUT_FREE'])))
          && (!('cuisines' in p) || (p.cuisines is list
              && p.cuisines.hasOnly(['COLOMBIAN', 'ITALIAN', 'ASIAN', 'MEXICAN', 'MEDITERRANEAN'])))
          && (!('spice' in p) || p.spice in ['MILD', 'MEDIUM', 'HOT'])
          && (!('budget' in p) || p.budget in ['ECONOMIC', 'MODERATE', 'UNLIMITED']);
      }

      // Edición del Perfil (spec 008, RNF-PER-01): solo campos conocidos y válidos; la constancia de términos y
      // createdAt no se pueden cambiar porque no están en la lista de campos editables.
      function validProfileUpdate() {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'email', 'phone', 'birthDate', 'photoPath', 'photoUrl', 'preferences', 'updatedAt'])
          && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 50
          && d.email is string
          && (!('phone' in d) || (d.phone is string && d.phone.matches('^3[0-9]{9}$')))
          && (!('birthDate' in d) || (d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && ((!('photoPath' in d) && !('photoUrl' in d))
              || (d.photoPath is string && d.photoUrl is string
                  && d.photoPath.matches('^users/' + uid + '/profile/[^/]+$')))
          && (!('preferences' in d) || validPreferences(d.preferences))
          && d.updatedAt == request.time;
      }
      allow read, delete: if isOwner(uid);
      allow update: if isOwner(uid) && validProfileUpdate();
      // Al crear el perfil se exige la constancia de aceptación de los documentos legales, con la hora del servidor.
      allow create: if isOwner(uid)
        && request.resource.data.termsVersion is string
        && request.resource.data.termsAcceptedAt == request.time;
    }

    // Inventario (spec 006, plan §3). La regla de users/{uid} no cubre las subcolecciones.
    match /users/{uid}/inventory/{itemId} {
      function validItem(d) {
        return d.keys().hasOnly(['name', 'nameNormalized', 'category', 'expiresOn', 'quantity', 'unit',
                                 'price', 'photoPath', 'photoUrl', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 50
          && d.nameNormalized is string
          && d.category in ['FRUITS', 'DAIRY', 'PROTEINS', 'VEGETABLES', 'GRAINS', 'OTHER']
          && d.expiresOn is string && d.expiresOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validQuantity(d)
          && validPrice(d)
          && validPhoto(d)
          && d.updatedAt == request.time;
      }
      // Cantidad y unidad van juntas: las dos ausentes o las dos válidas (T002, CA-INV-02-08, 02-09).
      function validQuantity(d) {
        return (!('quantity' in d) && !('unit' in d))
          || (d.quantity is number && d.quantity > 0 && d.quantity <= 9999
              && d.unit in ['UNITS', 'GRAMS', 'KILOGRAMS', 'POUNDS', 'MILLILITERS', 'LITERS']);
      }
      // Precio opcional en pesos enteros (T052, CA-INV-02-10, 02-11).
      function validPrice(d) {
        return !('price' in d) || (d.price is int && d.price > 0 && d.price <= 99999999);
      }
      // La ruta y la URL de la foto también van juntas.
      function validPhoto(d) {
        return (!('photoPath' in d) && !('photoUrl' in d))
          || (d.photoPath is string && d.photoUrl is string);
      }

      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validItem(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validItem(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Recuperación de contraseña: solo la usan las Cloud Functions con el Admin SDK, que no pasa por estas reglas.
    match /passwordResets/{id} {
      allow read, write: if false;
    }

    // Bienvenidas enviadas: solo las usa la función sendWelcomeEmail (spec 004).
    match /welcomeEmails/{id} {
      allow read, write: if false;
    }

    // Cambios de correo con código: solo los usan las funciones requestEmailChangeCode y confirmEmailChange (spec 008).
    match /emailChanges/{uid} {
      allow read, write: if false;
    }
  }
}
