{
  "name": "smartfood-functions",
  "description": "Cloud Functions de SmartFood: recuperación de contraseña real (spec 003).",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"lib/test/**/*.test.js\"",
    "serve": "npm run build && firebase emulators:start --only auth,firestore,functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.3"
  }
}
